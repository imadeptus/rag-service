# LLM provider: fake | openai-compatible | gigachat
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# GigaChat OAuth (when LLM_PROVIDER=gigachat)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Embeddings: fake | openai-compatible
EMB_PROVIDER=fake
EMB_BASE_URL=
EMB_API_KEY=
EMB_MODEL=text-embedding-3-small
EMB_DIM=256

# Vector store: memory | qdrant
STORE_BACKEND=memory
QDRANT_URL=http://localhost:6333
COLLECTION=docs

# Retrieval
TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=120
